PORT=5000
NODE_ENV=production
# Thay thế bằng chuỗi kết nối Neon PostgreSQL của bạn:
DATABASE_URL=postgresql://neondb_owner:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SESSION_SECRET=super_secure_rental_session_secret_key_2026_jwt_or_cookie
ADMIN_COOKIE_SECRET=admin_secret_key_long_and_cryptographically_strong_random_hash
AI_SERVICE_URL=http://localhost:8000
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MOCK_FALLBACK=true

# Frontend Public Domains & CORS
FRONTEND_URL=https://nhatrothanhtam.netlify.app
ALLOWED_ORIGINS=https://nhatrothanhtam.netlify.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Cookie Cross-Site (cần SameSite=none và secure=true khi frontend & backend khác domain)
COOKIE_SAMESITE=none
COOKIE_SECURE=true
