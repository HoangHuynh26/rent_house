# Frontend Environment Variables
# Đặt biến này trong Netlify / Vercel: Site configuration → Environment variables
# Hoặc copy thành file frontend/.env để chạy local / build public

# 1. Khi kết nối trực tiếp đến Backend Render Public:
VITE_API_URL=https://rent-house-3jm7.onrender.com/api

# 2. Khi chạy thông qua Netlify Proxy:
# VITE_API_URL=/api

# 3. Khi chạy Local:
# VITE_API_URL=http://localhost:5000/api
