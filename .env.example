# Backend Configuration (Deploy on VPS / Render / Railway)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require
PORT=5000
# NODE_ENV=production
SESSION_SECRET=your_super_secret_session_key
ADMIN_COOKIE_SECRET=your_super_secret_cookie_key
AI_SERVICE_URL=http://localhost:8000
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MOCK_FALLBACK=true

# Frontend public domain & CORS
FRONTEND_URL=https://nhatrothanhtam.netlify.app
ALLOWED_ORIGINS=https://nhatrothanhtam.netlify.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Cross-Site Cookie Flags
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Frontend API URL (Set this in Netlify Environment Variables: VITE_API_URL)
# Ví dụ: VITE_API_URL=https://rent-house-3jm7.onrender.com/api
VITE_API_URL=https://rent-house-3jm7.onrender.com/api
